# Google Analytics 4 measurement ID for Bookata.
#
# Optional. When unset, the build uses the production id (G-DBKB5VF49W),
# committed in src/lib/analytics.ts because a measurement id is public by design
# and an unset variable would otherwise silently mean no analytics at all. Set
# this variable only to point a build at a different property, for example a
# staging one.
#
# Format: G-XXXXXXXXXX. Create the property at analytics.google.com, in
# Admin > Data streams > Web, for the domain bookata.es.
#
# Bookata must have its OWN property. Do not reuse the ValuePerFan ID.
NEXT_PUBLIC_GA_ID=
